PORT=3001
GPS_URL=https://its.mobilidade.rio/v1/geolocalizacao/veiculos
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY=false
METRICS_TOKEN=
MAX_IDADE_ONIBUS_MS=180000
GPS_TIMEOUT_MS=15000
GPS_CLOCK_SKEW_MS=30000
GPS_MAX_SPEED_KMH=100
GPS_RIO_MIN_LAT=-23.2
GPS_RIO_MAX_LAT=-22.6
GPS_RIO_MIN_LNG=-43.9
GPS_RIO_MAX_LNG=-42.9
# Baixe a URL do feed GTFS no portal oficial da SMTR e configure aqui.
GTFS_URL=
GTFS_ALL_DAYS=1
# URLs dos serviços gratuitos; substitua por instâncias/provedores próprios se necessário.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSRM_URL=https://router.project-osrm.org/route/v1/driving
MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Obrigatório em produção; contato enviado no User-Agent do Nominatim.
CONTATO_APP=seu-email@example.com
